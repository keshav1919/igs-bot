# ==========================================
# Indo Commerce & Inventory Bot Configuration
# ==========================================

# Application
APP_NAME="Indo Commerce & Inventory System"
DEBUG=False

# Web Admin Host & Port
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000

# Security (Replace with a strong random secret in production)
SECRET_KEY=replace-with-a-64-character-random-hex-string-here-2026
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminPass@2026

# Database (Local SQLite with WAL mode by default)
DATABASE_URL=sqlite+aiosqlite:///./indo_selling.db

# Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Inventory Defaults
DEFAULT_CURRENCY=IDR
DEFAULT_STOCK_ALERT_THRESHOLD=5
